#Porta da API
PORT=7777

#Banco de dados MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=helpdesk
MYSQL_USER=
MYSQL_PASSWORD=

#Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=

#Conta Gmail usada para enviar e-mails (use uma senha de app, não a senha da conta)
EMAIL_USER=
EMAIL_PASSWORD=
#Opcional: endereço exibido como remetente (padrão: EMAIL_USER)
EMAIL_FROM=

#URL do frontend (CORS e links dos e-mails). Ex.: https://seu-frontend.exemplo.com
FRONTEND_URL=http://localhost:5173

#Senha temporária de primeiro acesso dos usuários criados pelo administrador
DEFAULT_USER_PASSWORD=

#Opcional: link de download direto de um manual em PDF anexado ao e-mail de boas-vindas
MANUAL_PDF_URL=
